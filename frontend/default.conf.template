server {
    listen 80;

    # SPA: estaticos, con fallback a index.html para el router del front
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # La direccion del backend y el DNS llegan por variables de entorno:
    # en compose, el nombre del servicio y el DNS de Docker; en Render,
    # la URL de la api de ESE entorno y un DNS publico.
    #
    # El nombre va en una variable (no en el proxy_pass directo) para que
    # nginx lo resuelva recien cuando llega un pedido, no al arrancar --
    # si no, se niega a levantar si el backend todavia no existe.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $backend_api ${BACKEND_URL};

    location /api/ {
        proxy_pass $backend_api;
        proxy_ssl_server_name on;   # la api de Render es https: sin esto el TLS no sabe a que host va
    }
}